{
    "name": "jeremykenedy/laravel-email-database-log",
    "description": "A database logger for all outgoing emails sent by your Laravel application.",
    "keywords": [
        "laravel",
        "markdown",
        "mail"
    ],
    "license": "MIT",
    "type": "package",
    "authors": [
        {
            "name": "Jeremy Kenedy",
            "email": "jeremykenedy@gmail.com"
        },
        {
            "name": "Alexander Shvets",
            "email": "neochief@shvetsgroup.com"
        },
        {
            "name": "Spaan Productions",
            "email": "info@spaanproductions.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.5|^9.0|^10.0|^11.0|^12.0|^13.0",
        "doctrine/dbal": "^3.6|^4.3",
        "nesbot/carbon": "^2.66|^3.8"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.0|^11.0|^12.0|^13.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "jeremykenedy\\LaravelEmailDatabaseLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "jeremykenedy\\LaravelEmailDatabaseLog\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "jeremykenedy\\LaravelEmailDatabaseLog\\LaravelEmailDatabaseLogServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage --coverage-filter src",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "suggest": {
        "jeremykenedy/laravel-ui-kit": "Optional Blade components for the dashboard (requires a compatible Laravel/PHP version)."
    }
}
